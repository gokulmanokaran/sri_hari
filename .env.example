# Google Maps Platform API Key
# Replace with your actual Google Maps JavaScript API key from Google Cloud Console
# Ensure Maps JavaScript API is enabled in your Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google Sheets & Email Notification Webhook URL
# Deploy the included google-apps-script.js as a Web App and paste the URL here:
VITE_ORDER_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Razorpay Key ID (For future live payments)
# VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
